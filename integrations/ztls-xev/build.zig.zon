.{
    .name = .ztls_xev,
    .version = "0.0.0",
    .fingerprint = 0xe9b19ec0837bab07, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // In-tree development dependency. External consumers fetch the root
        // package and opt into its `ztls_xev` module; see #79.
        .ztls = .{
            .path = "../..",
        },
        // libxev is the point of this integration, not an optional extra, so
        // it is a normal (non-lazy) dependency, unlike zio in ztls-std.
        .libxev = .{
            .url = "git+https://github.com/mitchellh/libxev#7497c85dfc3ae5141308944f2cd47c836772c300",
            .hash = "libxev-0.0.0-86vtc6BWFAAs_tGsasNfjQsxSsElhddIUnqVwGhwdnsu",
        },
        // Test-only: plain-text test runner. Lazy so consumers never fetch it.
        .ztest = .{
            .url = "https://github.com/mattrobenolt/ztest/archive/e8a7c83a961502ff85ed82fbab06af78c81a0836.tar.gz",
            .hash = "ztest-0.2.0-h6PBzyKEAAC49mtm1NO2CTeniItVuL0l06TpBDMDTe19",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
