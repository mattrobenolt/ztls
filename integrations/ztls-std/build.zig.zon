.{
    .name = .ztls_std,
    .version = "0.0.0",
    .fingerprint = 0x45842379ee2c17fe, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // In-tree development dependency. External consumers fetch the root
        // package and import its `ztls_std` module; see #79.
        .ztls = .{
            .path = "../..",
        },
        // Example-only. zio is a stackful-coroutine runtime that implements
        // `std.Io`, which is the interface ztls-std already targets — so it needs
        // no adapter and gets no package of its own, just
        // `examples/zio_client.zig` proving the integration. Lazy so a consumer
        // of ztls-std never fetches an I/O runtime it did not ask for.
        .zio = .{
            // v0.19.1 is the first tagged release past the old commit pin. It
            // carries zio #735, which drops the reserved AArch64 FFR clobber
            // that made Zig report a successful build as a failure (#104).
            .url = "git+https://github.com/lalinsky/zio?ref=v0.19.1#4daa0c0a9522a37c4d28e3dcec2515cc955abe71",
            .hash = "zio-0.19.1-xHbVVJXzKwAKLRAABWeDvQG9Dg1kf9FM3haWG0YqtScn",
            .lazy = true,
        },
        // Test-only: plain-text test runner. Lazy so consumers never fetch it.
        .ztest = .{
            .url = "https://github.com/mattrobenolt/ztest/archive/d1a70d1e99d4e8751d5ceddfe8dcc761e7831aad.tar.gz",
            .hash = "ztest-0.2.0-h6PBz_h1AAD8Z41oiZbR5aKo2xAzeqbuW9KIxfClUgwp",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
