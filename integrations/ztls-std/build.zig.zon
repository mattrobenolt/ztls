.{
    .name = .ztls_std,
    .version = "0.0.0",
    .fingerprint = 0x45842379ee2c17fe, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // In-tree path dep on the ztls core. Mirrors the conformance/ pattern
        // (conformance/build.zig.zon uses `.path = "../`"). From
        // integrations/ztls-std the repo root is ../.. .
        // Publish-time, this swaps to a git-URL/tag dep on a published ztls —
        // see #79 (distribution strategy). Dev-time, path.
        .ztls = .{
            .path = "../..",
        },
        // Example-only. zio is a stackful-coroutine runtime that implements
        // `std.Io`, which is the interface ztls-std already targets — so it needs
        // no adapter and gets no package of its own, just
        // `examples/zio_client.zig` proving the integration. Lazy so a consumer
        // of ztls-std never fetches an I/O runtime it did not ask for.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#v0.16.0",
            .hash = "zio-0.16.0-xHbVVJQxIgAMdBlOCF65siVKJRVww9Z_ayfJanpk7VEK",
            .lazy = true,
        },
        // Test-only: plain-text test runner. Lazy so consumers never fetch it.
        .ztest = .{
            .url = "https://github.com/mattrobenolt/ztest/archive/e8a7c83a961502ff85ed82fbab06af78c81a0836.tar.gz",
            .hash = "ztest-0.2.0-h6PBzyKEAAC49mtm1NO2CTeniItVuL0l06TpBDMDTe19",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
