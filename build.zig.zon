            .hash = "benchmark-0.1.0-JS72VvXxAACo8j9BYddbkivgNHXIeD1V27013BuCtW-_",
            .lazy = true,
        },
        // Test-only: plain-text test runner that writes one line per test to
        // stderr instead of Zig's TUI progress protocol. Lazy so consumers of
