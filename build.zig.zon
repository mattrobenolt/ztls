        .libxev = .{
            .url = "git+https://github.com/mitchellh/libxev#7497c85dfc3ae5141308944f2cd47c836772c300",
            .hash = "libxev-0.0.0-86vtc6BWFAAs_tGsasNfjQsxSsElhddIUnqVwGhwdnsu",
            .lazy = true,
        },
    },
    .paths = .{
        "LICENSE",
        "LICENSE-ZIG",
        "build.zig",
        "build.zig.zon",
        "src",
        "tests/fixtures",
        "integrations/ztls-std/src",
        "integrations/ztls-xev/src",
        "integrations/ztls-ktls/src",
    },
}
